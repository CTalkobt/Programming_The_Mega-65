10 DOPEN#3, "STOCK", L24
20 IF DS THEN PRINT DS$ : STOP
30 FOR R = 1 TO 4 : READ N$, Q
40 RECORD#3, R : PRINT#3, N$ "," Q
50 NEXT
60 DCLOSE#3
70 DATA BOLTS, 120, NUTS, 300, WASHERS, 75, SCREWS, 40
100 DOPEN#3, "STOCK", L24
110 INPUT "PART NUMBER"; R
120 RECORD#3, R : INPUT#3, N$, Q
130 IF ASC(N$) = 255 THEN PRINT "NO SUCH PART" : GOTO 170
140 PRINT N$; Q; "IN STOCK" : INPUT "CHANGE BY"; C
150 RECORD#3, R : PRINT#3, N$ "," Q + C
160 IF DS THEN PRINT DS$
170 DCLOSE#3
