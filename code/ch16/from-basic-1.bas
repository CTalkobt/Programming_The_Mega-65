10 DO
20 POKE $D614, 1 : K = PEEK($D613)                   : REM COLUMN 1
30 IF (K AND 2) = 0 THEN PRINT "W ";
40 IF (K AND 4) = 0 THEN PRINT "A ";
50 IF (K AND 32) = 0 THEN PRINT "S ";
60 POKE $D614, 2 : IF (PEEK($D613) AND 4) = 0 THEN PRINT "D ";
70 POKE $D614, 7 : IF (PEEK($D613) AND 16) = 0 THEN PRINT "SPACE";
80 PRINT
90 LOOP
