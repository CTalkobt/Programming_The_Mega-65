10 REM 16-COLOUR SPRITE WITH A 16-BIT POINTER
20 PL=$40000 : SD=$40100 : H=32       : REM POINTER LIST, DATA, HEIGHT
30 DIM CL(4) : FOR I=0 TO 4 : READ CL(I) : NEXT I
40 DATA 1,7,8,10,2
50 FOR Y=0 TO H-1 : FOR X=0 TO 15
60 U=(X-7.5)/8 : V=(Y-15.5)/16 : E=SQR(U*U+V*V)
70 C=0 : IF E<1 THEN C=CL(INT(E*5))
80 A=SD+Y*8+INT(X/2)
90 IF (X AND 1)=0 THEN POKE A,C*16 : ELSE POKE A,PEEK(A) OR C
100 NEXT X,Y
110 CLRBIT $D05D,7                     : REM HOTREG OFF
120 P0=PEEK($D06C) : P1=PEEK($D06D) : P2=PEEK($D06E)
130 WPOKE PL,SD/64                     : REM SPRITE 0 POINTER, 16 BITS
140 POKE $D06C,0 : POKE $D06D,0 : POKE $D06E,$84 : REM LIST AT $40000
150 SETBIT $D06B,0                     : REM 16-COLOUR
160 SETBIT $D055,0 : H0=PEEK($D056) : POKE $D056,H : REM HEIGHT
170 POKE $D027,0                       : REM COLOUR 0 IS TRANSPARENT
180 MOVSPR 0,40,100 : SETBIT $D015,0
190 MOVSPR 0,90#2                      : REM MOVE RIGHT
200 GETKEY K$
210 CLRBIT $D015,0 : MOVSPR 0,0#0
220 CLRBIT $D06B,0 : CLRBIT $D055,0 : POKE $D056,H0
230 POKE $D06C,P0 : POKE $D06D,P1 : POKE $D06E,P2
240 SETBIT $D05D,7
