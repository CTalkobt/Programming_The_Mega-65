10 REM RRB OBJECTS: FOUR 16X16 FCM BALLS
20 SA=$50000 : CA=$FF82000 : LS=128 : BL=$1001 : IM=$1002 : GA=IM*64
30 DIM R(13),X(3),Y(3),DX(3),DY(3),OW(3),IG(3)
40 FOR I=0 TO 13 : R(I)=PEEK($D058+I) : NEXT
50 TX=WPEEK($D04C) : HR=PEEK($D05D)
60 EDMA 3,576,0,$40000 : REM CLEAR TWO BLANKS AND THE IMAGE
70 FOR PY=0 TO 15 : FOR PX=0 TO 15 : C=0
80 IF (PX-7.5)^2+(PY-7.5)^2<56 THEN C=2 : IF (PX-5)^2+(PY-5)^2<5 THEN C=1
90 POKE GA+(1+INT(PX/8)*3)*64+PY*8+MOD(PX,8),C : NEXT : NEXT
100 FOR Y=0 TO 24 : A=Y*LS
110 FOR E=0 TO 39 : WPOKE SA+A+E*2,102 : WPOKE CA+A+E*2,$0B00 : NEXT
120 FOR N=0 TO 3 : P=A+80+N*6
130 WPOKE SA+P,0 : WPOKE CA+P,$0090 : REM GOTOX 0, TRANSPARENT
140 WPOKE SA+P+2,BL : WPOKE SA+P+4,BL : WPOKE CA+P+2,0 : WPOKE CA+P+4,0 : NEXT
150 WPOKE SA+A+104,320 : WPOKE CA+A+104,$0010 : REM GOTOX 320
160 WPOKE SA+A+106,32 : WPOKE CA+A+106,$0100 : NEXT
170 CLRBIT $D05D,7 : CLRBIT $D031,7 : WPOKE $D04C,80
180 SETBIT $D054,0 : SETBIT $D054,2 : WPOKE $D058,LS : POKE $D05E,54
190 WPOKE $D060,0 : POKE $D062,5 : WPOKE $D064,$2000
200 FOR N=0 TO 3 : X(N)=30+N*80 : Y(N)=10+N*40 : DX(N)=N+1 : DY(N)=4-N
210 OW(N)=99 : IG(N)=IM : NEXT
220 FOR T=1 TO 600
230 FOR N=0 TO 3 : X(N)=X(N)+DX(N) : Y(N)=Y(N)+DY(N)
240 IF X(N)<0 OR X(N)>304 THEN DX(N)=-DX(N) : X(N)=X(N)+2*DX(N)
250 IF Y(N)<0 OR Y(N)>184 THEN DY(N)=-DY(N) : Y(N)=Y(N)+2*DY(N)
260 GOSUB 1000 : NEXT
270 SLEEP 0.02 : NEXT
280 SETBIT $D031,7 : CLRBIT $D054,0 : CLRBIT $D054,2
290 FOR I=0 TO 13 : POKE $D058+I,R(I) : NEXT
300 WPOKE $D04C,TX : POKE $D05D,HR : END
1000 REM DRAW OBJECT N AT X(N),Y(N)
1010 P=80+N*6 : IF OW(N)=99 THEN 1040
1020 FOR J=0 TO 2 : RW=OW(N)+J : IF RW>=0 AND RW<25 THEN A=SA+RW*LS+P : WPOKE A+2,BL : WPOKE A+4,BL
1030 NEXT
1040 RW=INT(Y(N)/8) : D=Y(N)-RW*8 : OW(N)=RW : XP=X(N) : IF XP<0 THEN XP=XP+1024
1050 G=XP+$1000+D*$2000 : REM GOTOX XP, CHARACTERS D PIXELS LOWER
1060 FOR J=0 TO 2 : RW=OW(N)+J : IF RW>=0 AND RW<25 THEN A=SA+RW*LS+P : WPOKE A,G : WPOKE A+2,IG(N)+1+J : WPOKE A+4,IG(N)+4+J
1070 NEXT : RETURN
