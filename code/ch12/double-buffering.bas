10 REM PAGE FLIPPING: DRAW OUT OF SIGHT, THEN SWITCH
20 D=1 : B=0 : X=0 : Y=0 : DX=1 : DY=1
30 EDMA 3,2000,1,$FF80000              : REM WHITE TEXT COLOUR
40 HR=PEEK($D05D) : P0=WPEEK($D060) : P2=PEEK($D062)
50 CLRBIT $D05D,7
60 O=0 : IF D THEN O=B*2048             : REM BUFFER TO DRAW IN
70 A=$50000+O : EDMA 3,2000,32,A        : REM CLEAR IT
80 FOR R=0 TO 7 : EDMA 3,16,160,A+(Y+R)*80+X : NEXT R
90 VSYNC 255 : WPOKE $D060,O : POKE $D062,5 : REM SHOW IT
100 IF D THEN B=1-B
110 X=X+DX : IF X=0 OR X=64 THEN DX=-DX
120 Y=Y+DY : IF Y=0 OR Y=17 THEN DY=-DY
130 GET K$ : IF K$=" " THEN D=1-D
140 IF K$="" OR K$=" " THEN 60
150 WPOKE $D060,P0 : POKE $D062,P2 : POKE $D05D,HR : PRINT CHR$(147);
