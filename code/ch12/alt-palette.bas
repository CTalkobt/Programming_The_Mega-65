10 REM A NEGATIVE ALTERNATE PALETTE FOR BOLD + REVERSE TEXT
20 P=PEEK($D070) : DIM R(31),G(31),B(31)
30 FOR C=0 TO 31 : R(C)=PEEK($D100+C) : G(C)=PEEK($D200+C)
40 B(C)=PEEK($D300+C) : NEXT C
50 POKE $D070,(P AND $3F) OR $80       : REM EDIT BANK 2
60 FOR C=0 TO 31 : POKE $D100+C,255-R(C) : POKE $D200+C,255-G(C)
70 POKE $D300+C,255-B(C) : NEXT C
80 POKE $D070,(P AND $FC) OR 2         : REM ALTERNATE IS BANK 2
90 PRINT CHR$(147); : CR=$FF80000
100 FOR Y=1 TO 7 STEP 2 : CURSOR 2,Y
110 PRINT "THE QUICK BROWN FOX JUMPS OVER THE LAZY DOG"
120 NEXT Y
130 FOR X=2 TO 44 : A=CR+3*80+X : POKE A,PEEK(A) OR 96 : NEXT X
140 FOR X=12 TO 26 : A=CR+7*80+X : POKE A,PEEK(A) OR 96 : NEXT X
150 GETKEY K$ : POKE $D070,P
