10 REM FULL-COLOUR CHARACTERS NEXT TO TEXT
20 SA=$50000 : CA=$FF82000 : GD=$40000 : W=80
30 FOR Y=0 TO 7 : FOR X=0 TO 7
40 POKE GD+Y*8+X,16+((X+Y) AND 15)         : REM GLYPH $1000: RAINBOW
50 D=(X-3.5)*(X-3.5)+(Y-3.5)*(Y-3.5)
60 V=0 : IF D<14 THEN V=255 : IF D<5 THEN V=1
70 POKE GD+64+Y*8+X,V                      : REM GLYPH $1001: BALL
80 NEXT X,Y
90 FOR R=0 TO 24 : FOR E=0 TO 39 : A=R*W+E*2
100 C=32 : K=1 : IF R>=2 THEN C=$1000+((R+E) AND 1) : K=16+MOD(E,16)
110 WPOKE SA+A,C : POKE CA+A,0 : POKE CA+A+1,K : NEXT E,R
120 T$="FULL-COLOUR CHARACTERS AND TEXT"
130 FOR I=1 TO LEN(T$) : C=ASC(MID$(T$,I,1)) : IF C>=64 THEN C=C-64
140 WPOKE SA+(I+3)*2,C : NEXT I
150 DIM R(13) : FOR I=0 TO 13 : R(I)=PEEK($D058+I) : NEXT
160 TX=WPEEK($D04C) : HR=PEEK($D05D) : D1=PEEK($D031)
170 CLRBIT $D05D,7 : POKE $D031,D1 AND $5F : POKE $D04C,80
180 POKE $D054,PEEK($D054) OR 5           : REM CHR16 + FCLRHI
190 WPOKE $D058,W : POKE $D05E,40
200 WPOKE $D060,0 : POKE $D062,5 : WPOKE $D064,$2000
210 GETKEY K$
220 POKE $D031,D1 : POKE $D054,PEEK($D054) AND $FA
230 FOR I=0 TO 13 : POKE $D058+I,R(I) : NEXT
240 WPOKE $D04C,TX : POKE $D05D,HR
