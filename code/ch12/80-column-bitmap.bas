10 REM A 640 X 200 VIC-II-STYLE BITMAP IN BANK 4
20 BM=$40000 : SC=$44000
30 EDMA 3,16000,0,BM : EDMA 3,2000,$16,SC : REM WHITE ON BLUE
50 FOR X=0 TO 639 : Y=100-INT(90*SIN(X/50)) : GOSUB 200 : Y=100 : GOSUB 200 : NEXT X
60 FOR I=0 TO 79 : POKE SC+960+I,$76 : NEXT : REM ROW 12 YELLOW
70 DIM R(13) : FOR I=0 TO 13 : R(I)=PEEK($D058+I) : NEXT
80 HR=PEEK($D05D) : D1=PEEK($D011) : C0=PEEK($D068) : C1=PEEK($D069)
85 C2=PEEK($D06A)
90 CLRBIT $D05D,7
100 POKE $D068,0 : POKE $D069,0 : POKE $D06A,4 : REM CHARPTR = BITMAP
110 WPOKE $D060,$4000 : POKE $D062,4           : REM SCRNPTR = COLOURS
120 SETBIT $D011,5                              : REM BITMAP MODE
130 GETKEY K$
140 POKE $D011,D1 : FOR I=0 TO 13 : POKE $D058+I,R(I) : NEXT
150 POKE $D068,C0,C1,C2 : POKE $D05D,HR
160 END
200 A=BM+INT(Y/8)*640+INT(X/8)*8+(Y AND 7)
210 POKE A,PEEK(A) OR 2^(7-(X AND 7)) : RETURN
