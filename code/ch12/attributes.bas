10 REM VIC-III TEXT ATTRIBUTES
20 PRINT CHR$(147); : CR=$FF80000
30 FOR I=0 TO 6 : READ A$,V
40 PRINT : PRINT "  ";A$ : Y=2*I+1
50 FOR X=2 TO 21 : A=CR+Y*80+X : POKE A,(PEEK(A) AND 15) OR V : NEXT X
60 NEXT I
70 DATA "PLAIN TEXT",0,"BLINK",16,"REVERSE",32,"BOLD",64
80 DATA "UNDERLINE",128,"BLINKING UNDERLINE",144,"BOLD + REVERSE",96
