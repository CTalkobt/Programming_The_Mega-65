10 REM 16-COLOUR BITPLANE SCREEN, SET UP BY HAND
20 DIM A(3) : A(0)=$40000 : A(1)=$50000 : A(2)=$42000 : A(3)=$52000
30 FOR R=0 TO 24 : FOR CX=0 TO 39
40 C=(INT(CX/2)+R) AND 15 : O=R*320+CX*8
50 FOR N=0 TO 3 : EDMA 3,8,-255*((C AND 2^N)>0),A(N)+O : NEXT N
60 NEXT CX,R
70 D1=PEEK($D031) : D7=PEEK($D07C)
80 POKE $D033,0,0,34,34                : REM PLANE ADDRESSES
90 POKE $D07C,(D7 AND $F8) OR 2         : REM BANKS 4 AND 5
100 POKE $D032,$0F                      : REM PLANES 0-3 ON
110 POKE $D031,(D1 AND $77) OR $10      : REM 320 X 200, BPM ON
120 GETKEY K$ : POKE $D03B,8            : REM INVERT PLANE 3
130 GETKEY K$ : POKE $D03B,0
140 POKE $D031,D1 : POKE $D032,0 : POKE $D07C,D7
