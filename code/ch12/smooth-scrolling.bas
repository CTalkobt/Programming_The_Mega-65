10 REM SMOOTH SCROLLING OVER A 160-COLUMN MAP
20 SA=$50000 : CO=$2000 : W=160
30 EDMA 3,W*25,32,SA : EDMA 3,W*25,5,$FF80000+CO : REM SPACES, GREEN
40 FOR X=0 TO W-1 : H=INT(9+6*SIN(X/8)+3*SIN(X/3))
50 FOR Y=25-H TO 24 : POKE SA+Y*W+X,160 : NEXT Y
60 IF MOD(X,10)=0 THEN POKE SA+X,48+MOD(X/10,10) : POKE $FF80000+CO+X,1
70 NEXT X
80 DIM R(13) : FOR I=0 TO 13 : R(I)=PEEK($D058+I) : NEXT : T=PEEK($D04C)
90 CLRBIT $D05D,7                     : REM HOTREG OFF
100 WPOKE $D058,W : POKE $D05E,81      : REM LINESTEP, CHRCOUNT
110 FOR P=0 TO (W-80)*8-1 STEP 2
120 C=INT(P/8) : F=P AND 7
130 VSYNC 255
140 POKE $D04C,80-F                    : REM FINE: TEXTXPOS
150 WPOKE $D060,C : POKE $D062,5       : REM COARSE: SCRNPTR
160 WPOKE $D064,CO+C                   : REM AND COLPTR
170 GET K$ : IF K$="" THEN NEXT P
180 FOR I=0 TO 13 : POKE $D058+I,R(I) : NEXT : POKE $D04C,T
190 SETBIT $D05D,7
