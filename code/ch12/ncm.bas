10 REM NYBBLE-COLOUR CHARACTERS
20 SA=$50000 : CA=$FF82000 : GD=$40000 : W=80
30 FOR Y=0 TO 7 : FOR X=0 TO 15
40 U=(X-7.5)/8 : V=(Y-3.5)/4 : N=0 : IF U*U+V*V<1 THEN N=1+INT(X*13/15)
50 A=GD+Y*8+INT(X/2)
60 IF (X AND 1)=0 THEN POKE A,N : ELSE POKE A,PEEK(A) OR N*16
70 NEXT X,Y
80 FOR I=0 TO 999 : WPOKE SA+I*2,32 : NEXT : EDMA 3,2000,1,CA
90 FOR R=2 TO 20 STEP 2 : G=MOD(R/2,2)
100 FOR E=0 TO 19 : A=R*W+E*2 : WPOKE SA+A,$1000
110 POKE CA+A,8 : POKE CA+A+1,G*16+1 : NEXT E,R
120 T$="MIXED ROW:" : A=23*W : GOSUB 300
130 FOR I=1 TO 5 : WPOKE SA+A,$1000 : POKE CA+A,8 : POKE CA+A+1,17
140 A=A+2 : NEXT I : T$="AND TEXT" : GOSUB 300
150 DIM R(13) : FOR I=0 TO 13 : R(I)=PEEK($D058+I) : NEXT
160 TX=WPEEK($D04C) : HR=PEEK($D05D) : D1=PEEK($D031)
170 CLRBIT $D05D,7 : POKE $D031,D1 AND $5F : POKE $D04C,80
180 SETBIT $D054,0 : WPOKE $D058,W : POKE $D05E,40
190 WPOKE $D060,0 : POKE $D062,5 : WPOKE $D064,$2000
200 GETKEY K$
210 POKE $D031,D1 : CLRBIT $D054,0
220 FOR I=0 TO 13 : POKE $D058+I,R(I) : NEXT
230 WPOKE $D04C,TX : POKE $D05D,HR : END
300 FOR I=1 TO LEN(T$) : C=ASC(MID$(T$,I,1)) : IF C>=64 THEN C=C-64
310 WPOKE SA+A,C : A=A+2 : NEXT I : RETURN
