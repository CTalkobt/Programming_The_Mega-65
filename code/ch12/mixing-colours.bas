10 REM THREE WAYS TO MIX RED AND YELLOW
20 BM=$40000 : SC=$44000
30 EDMA 3,16000,0,BM : EDMA 3,2000,0,SC        : REM ALL BLACK
40 FOR R=2 TO 5 : FOR Y=0 TO 7 : V=$AA : IF Y AND 1 THEN V=$55
50 FOR C=10 TO 69 : POKE BM+R*640+C*8+Y,V : NEXT C,Y
60 EDMA 3,60,$27,SC+R*80+10 : NEXT R            : REM DITHER
70 FOR R=8 TO 11 : EDMA 3,60,$FF,SC+R*80+10 : NEXT : REM FLICKER
80 FOR R=14 TO 17 : EDMA 3,60,$EE,SC+R*80+10 : NEXT : REM VALUE 128
90 FOR R=20 TO 23 : EDMA 3,60,$DD,SC+R*80+10 : NEXT : REM VALUE 188
100 POKE $D10D,$FF,$FF,$FF : POKE $D20D,$CB,$08,$00 : POKE $D30D,0,0,0
110 HR=PEEK($D05D) : D1=PEEK($D011) : DIM P(13)
120 FOR I=0 TO 13 : P(I)=PEEK($D058+I) : NEXT
130 C0=PEEK($D068) : C1=PEEK($D069) : C2=PEEK($D06A)
140 CLRBIT $D05D,7 : POKE $D068,0,0,4 : WPOKE $D060,$4000 : POKE $D062,4
150 SETBIT $D011,5
160 POKE $D10F,$FF : G=0                        : REM ENTRY 15: RED
170 VSYNC 255 : G=255-G : POKE $D20F,G          : REM RED, THEN YELLOW
180 GET K$ : IF K$="" THEN 170
190 POKE $D011,D1 : FOR I=0 TO 13 : POKE $D058+I,P(I) : NEXT
200 POKE $D068,C0,C1,C2 : POKE $D05D,HR : PALETTE RESTORE
