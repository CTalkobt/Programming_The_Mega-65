10 REM SEAM: 16-BIT CHARACTERS, FLIPS, TRIMS AND ROW ENDS
20 SA=$50000 : CA=$FF82000 : A=0
30 FOR I=0 TO 999 : WPOKE SA+I*2,32 : NEXT : EDMA 3,2000,0,CA : REM SPACES
40 K=1 : S$="A SEAM SCREEN, ONE ROW AT A TIME" : GOSUB 1000 : GOSUB 1100
50 GOSUB 1100
60 S$="FLIPS:      " : GOSUB 1000
70 FOR I=0 TO 3 : F=I*64 : C=18 : GOSUB 1200 : C=32 : F=0 : GOSUB 1200 : NEXT
80 GOSUB 1100 : GOSUB 1100
90 S$="CODES 1-26: " : GOSUB 1000
100 FOR C=1 TO 26 : GOSUB 1200 : NEXT : GOSUB 1100
110 S$="257-282:    " : GOSUB 1000
120 FOR C=257 TO 282 : GOSUB 1200 : NEXT : GOSUB 1100 : GOSUB 1100
130 S$="TRIMS:      " : GOSUB 1000
140 FOR I=0 TO 7 : C=160+I*$2000 : K=2+MOD(I,2)*5 : GOSUB 1200 : NEXT
150 GOSUB 1100 : GOSUB 1100 : K=1
160 S$="SHORT" : GOSUB 1000 : GOSUB 1100
170 S$="ROWS OF ANY LENGTH" : GOSUB 1000 : GOSUB 1100
180 DIM R(13) : FOR I=0 TO 13 : R(I)=PEEK($D058+I) : NEXT
190 TX=WPEEK($D04C) : HR=PEEK($D05D)
200 CLRBIT $D05D,7 : CLRBIT $D031,7 : POKE $D04C,80
210 SETBIT $D054,0 : WPOKE $D058,80 : POKE $D05E,40
220 WPOKE $D060,0 : POKE $D062,5 : WPOKE $D064,$2000
230 GETKEY K$
240 SETBIT $D031,7 : CLRBIT $D054,0
250 FOR I=0 TO 13 : POKE $D058+I,R(I) : NEXT
260 WPOKE $D04C,TX : POKE $D05D,HR : END
1000 REM ADD S$ TO THE ROW
1010 F=0 : FOR J=1 TO LEN(S$) : C=ASC(MID$(S$,J,1))
1020 IF C>=64 THEN C=C-64
1030 GOSUB 1200 : NEXT J : RETURN
1100 REM END THE ROW: MOVE TO THE NEXT ONE
1110 WPOKE SA+A,$FFFF : A=A+2 : RETURN
1200 REM ADD CHARACTER C, FLAGS F, COLOUR K
1210 WPOKE SA+A,C : POKE CA+A,F : POKE CA+A+1,K : A=A+2 : RETURN
