10 REM COLOUR CYCLING: A RAINBOW THAT FLOWS
20 DIM R(15),G(15),B(15)
30 FOR I=0 TO 15 : R(I)=PEEK($D110+I) : G(I)=PEEK($D210+I)
40 B(I)=PEEK($D310+I) : NEXT I
50 PRINT CHR$(147); : SC=$0800 : CR=$FF80000
60 FOR Y=0 TO 24 : FOR X=0 TO 79 : A=Y*80+X
70 POKE SC+A,160 : POKE CR+A,64+(INT((X+Y*2)/3) AND 15) : NEXT X,Y
80 T=0
90 VSYNC 255 : T=MOD(T+1,16)
100 FOR I=0 TO 15 : J=(I+T) AND 15
110 POKE $D110+I,R(J) : POKE $D210+I,G(J) : POKE $D310+I,B(J) : NEXT I
120 GET K$ : IF K$="" THEN 90
130 PALETTE RESTORE : PRINT CHR$(147);
